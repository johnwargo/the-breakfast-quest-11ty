---
layout: generic
title: Reviews
description: All reviews in reverse chronological order.
eleventyNavigation:
  key: Reviews
  order: 5
pagination:
  data: collections.reviewsByTimestamp
  size: 20
  alias: reviews
  reverse: true
---

<p>This page lists all restaurant reviews by date in chronological order.</p>

{% if reviews.length > 0  %}
  <hr class="major" />
  {% include 'pagination-count.html' %}

  {% for review in reviews | reverse %}
    <article>
      <h4>
        <a href="{{ review.url }}" style="cursor: pointer">{{ review.data.title }}</a>
      </h4>
      <strong>Posted:</strong>&nbsp; 
        {%- if review.data.timestamp %}
          {{ review.data.timestamp | readableTimestamp }}
        {%- else %}
          {{ review.date | readableDate }}
        {%- endif %}    
        {%- if review.data.categories.length > 0 %}&nbsp;in&nbsp;
          {%- for cat in review.data.categories %}
            <a href="/categories/{{ cat | slugify }}">{{ cat }}</a>
            {%- unless forloop.last %},{% endunless %}
          {%- endfor %}
        {% endif %}
        <br />
        {%- if review.data.visitDate.length > 0 %}<strong>Visits:</strong>&nbsp;{{ review.data.visitDate.length }}<br />{%- endif %}
        {% if review.data.description %}{{ review.data.description }}{% endif %}
      </article>
      <hr class="major" />
  {% endfor %}

  {% include 'pagination-nav.html' %}

{% else %}
  <p>No reviews found.</p>
{% endif %}