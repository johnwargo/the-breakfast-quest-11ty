---
layout: base
---

{% assign previousPost = collections.post | getPreviousCollectionItem %}
{% assign nextPost = collections.post | getNextCollectionItem %}

<section>
  <article>
    <header class="main">
      <h2>{{ title }}</h2>
      <p>{{ callout }}</p>
    </header>
    {% include "pretty-print.html" %}
      <br /><br />
      <strong>Published:</strong>&nbsp;
    {%- if timestamp %}
      {{ timestamp | readableTimestamp }}
    {%- else %}
      {{ date | readableDate }}
    {%- endif %}
    <br />
    {%- if isLocation%}
      {%- if visitDate %}
        <strong>Visited:</strong>
        {%- if visitDate.first %}
          {% assign visits = visitDate | sort %}
          {% for visit in visits | reverse %}
            {{ visit | readableDate  }}
            {%- unless forloop.last %},{% endunless %}
          {%- endfor %}
        {%-  else %}
          {{ visitDate | readableDate }}
        {%- endif %}
        <br />
      {% endif %}
      {%- if rating %}
        <strong>Rating:</strong> {{ rating }}<br />
      {% endif %}
      {%- if website %}
        <strong>Web site:</strong> <a href="{{ website }}" target="_blank">{{ website }}</a><br />
      {% endif %}
      {%- if menu %}
        <strong>Menu:</strong> <a href="{{ menu }}" target="_blank">{{ menu }}</a><br />
      {% endif %}      
      {%- if address %}
        <strong>Address:</strong> <a href="https://www.google.com/maps/search/?api=1&query={{ address | url_encode }}" target="_blank">{{ address }}</a><br />
      {% endif %}
    {%- endif %}
    {%- if categories.length > 0 %}
      <strong>Found in</strong>{% for cat in categories %}
      <a href="/categories/{{ cat | slugify }}">{{ cat }}</a>
      {%- unless forloop.last %},{% endunless %}{%- endfor %}.
      <br />
    {% endif %}
    <br />
    {%- if description %}
      <blockquote>{{ description }}</blockquote>
    {%- endif %}
    {{ content }}
    </article>
    {% if nextPost.url %}
      <a onClick="location.href='{{ nextPost.url }}'" 
      class="button primary">&lt;&lt;&nbsp;{{ nextPost.data.title }}</a>
    {% endif %}
    {% if previousPost.url %} 
      <a onClick="location.href='{{ previousPost.url }}'" 
      class="button primary">{{ previousPost.data.title }}&nbsp;&gt;&gt;</a>      
    {% endif %}
  </article>
</section>