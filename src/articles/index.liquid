---
layout: generic
title: Articles & Reviews
description: All articles in reverse chronological order.
eleventyNavigation:
  key: Articles
  order: 2
pagination:
  data: collections.articlesByTimestamp
  size: 20
  alias: posts
  reverse: true
---

<p>This page lists all articles in reverse chronological order. Use the <a href="/categories/">Categories</a> page to view the list of categories.</p>

{% include 'pagination-count.html' %}
<hr class="major" />
{% for post in posts %}
  <article>
    <h4>
      {%- if post.data.isLocation %}
        <a href="{{ post.url }}" style="cursor: pointer">Review: {{ post.data.title }}</a>
      {%- else %}
        <a href="{{ post.url }}" style="cursor: pointer">{{ post.data.title }}</a>
      {%- endif %}
    </h4>
    {%- if post.data.isLocation %}
      <br />
      <strong>Visit date(s):</strong>&nbsp;{{ post.data.visitDate | readableDate }}
    {%- endif %}
    <br /><strong>Posted: {%- if post.data.timestamp %}
        {{ post.data.timestamp | readableTimestamp }}
        {%- else %}
        {{ post.date | readableDate }}
        {%- endif %}</strong>    
    {%- if post.data.categories.length > 0 %}
      <br /><strong>Found in</strong>{% for cat in post.data.categories %}
        <a href="/categories/{{ cat | slugify }}">{{ cat }}</a>
        {%- unless forloop.last %},{% endunless %}{%- endfor %}.
    {% endif %}
    <br />
    {%- if post.data.generatedDescription %}
      <span class="generated">
        <a href="https://github.com/johnwargo/vscode-describer-genai/" target="_blank">
          AI Generated</a>
      </span>&nbsp;{%- endif %}
    {{ post.data.description }}
  </article>
  <hr class="major" />
{% endfor %}

{% include 'pagination-nav.html' %}
{% include "footer.html" %}