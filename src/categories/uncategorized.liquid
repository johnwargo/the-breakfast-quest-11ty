---js
{
  "layout": "generic",
  "pagination": {
    "data": "collections.articlesByTimestamp",
    "size": 20,
    "alias": "posts",
    "before": function(paginationData, fullData){ let data = paginationData.filter((item) => !item.data.categories || item.data.categories.length == 0); return Array.from(data).sort((a, b) => { return a.date < b.date ? 1 : -1; });}
  },
  "category": "Uncategorized",
  "description": "Posts without an assigned category.",
  "eleventyComputed": {
    "title": "{{ category }}"
  },
  "permalink": "categories/{{ category | slugify }}/{% if pagination.pageNumber != 0 %}page-{{ pagination.pageNumber }}/{% endif %}"
}
---

<p>{{ description }} This page lists category posts in reverse chronological order.</p>

{% include 'pagination-count.html' %}
<hr class="major" />
{% for post in posts %}
  <article>
    <h4>
      {%- if post.data.isLocation %}
        <a href="{{ post.url }}" style="cursor: pointer">Review: {{ post.data.title }}</a>
      {%- else %}
        <a href="{{ post.url }}" style="cursor: pointer">{{ post.data.title }}</a>
      {%- endif %}
    </h4>    
    <strong>Posted:</strong>&nbsp;
    {%- if post.data.timestamp %}
      {{ post.data.timestamp | readableTimestamp }}
    {%- else %}
      {{ post.date | readableDate }}
    {%- endif %}    
    <br />
     {% if post.data.description %}{{ post.data.description }}{% endif %}
  </article>
  <hr class="major" />
{% endfor %}
{% include 'pagination-nav.html' %}

{% comment %} {% include 'pagination-count.html' %}
<hr class="major" />
{% for post in catposts %}
  <article>
    <h4>
      <a href="{{post.url}}" style="cursor: pointer">{{ post.data.title }}</a>
    </h4>
    Posted {%- if post.data.timestamp %}
      {{ post.data.timestamp | readableTimestamp }}
      {%- else %}
      {{ post.date | readableDate }}
      {%- endif %}&nbsp;
    {% if post.data.categories.length > 0 %}
      in
      {% for cat in post.data.categories %}
        <a href="/categories/{{ cat | slugify }}">{{ cat }}</a>
        {%- unless forloop.last %},
        {% endunless %}
      {% endfor %}
    {% endif %}
    {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
  </article>
  <hr class="major" />  
{% endfor %}

{% include 'pagination-nav.html' %} {% endcomment %}
