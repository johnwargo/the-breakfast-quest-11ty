{
  "name": "breakfast-quest",
  "version": "0.0.6",
  "description": "Source code for thebreakfastquest.com",
  "keywords": [
    "eleventy"
  ],
  "author": "John M. Wargo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnwargo/the-breakfast-quest"
  },
  "bugs": {
    "url": "https://github.com/johnwargo/the-breakfast-quest/issues"
  },
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf _site",
    "build:eleventy": "eleventy",
    "watch:eleventy": "eleventy --serve --quiet",
    "start": "npm-run-all --sequential clean watch:eleventy",
    "build": "npm-run-all --sequential clean build:eleventy",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "eleventy-generate-category-pages": "^0.1.4",
    "eleventy-plugin-date": "^1.0.0",
    "eleventy-plugin-youtube-embed": "^1.13.2",
    "generate-build-info": "^0.0.3",
    "html-minifier": "^4.0.0",
    "markdown-it": "^14.2.0",
    "markdown-it-attrs": "^5.0.0",
    "netlify-plugin-cache": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.2"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
